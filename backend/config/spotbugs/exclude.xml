<?xml version="1.0" encoding="UTF-8"?>
<!-- Every exclusion must be justified in a comment. -->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">
  <!-- Spring injects collaborators through constructors: storing references to them is intended. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- Informational inventory of HTTP endpoints, not a vulnerability. Endpoint security is
       enforced by Spring Security tests, Semgrep and the ZAP baseline scan. -->
  <Match>
    <Bug pattern="SPRING_ENDPOINT"/>
  </Match>
</FindBugsFilter>
