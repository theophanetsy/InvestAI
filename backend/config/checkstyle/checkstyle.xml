<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Layout/whitespace is owned by Spotless (google-java-format).
  This config enforces conventions, naming, complexity and banned constructs.
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java, properties, xml, yml, yaml"/>

  <!-- Suppressions file is wired by the Maven plugin (suppressionsLocation). -->
  <module name="SuppressWarningsFilter"/>

  <module name="FileLength">
    <property name="max" value="500"/>
  </module>
  <module name="NewlineAtEndOfFile"/>
  <module name="FileTabCharacter"/>

  <!-- Banned patterns -->
  <module name="RegexpSingleline">
    <property name="format" value="System\.(out|err)\.print"/>
    <property name="message" value="Use an SLF4J logger instead of System.out/err."/>
  </module>
  <module name="RegexpSingleline">
    <property name="format" value="\.printStackTrace\(\)"/>
    <property name="message" value="Log the exception instead of printStackTrace()."/>
  </module>
  <module name="RegexpSingleline">
    <property name="format" value="(?i)(password|secret|api[_-]?key|token)\s*=\s*&quot;[^&quot;$]{4,}&quot;"/>
    <property name="message" value="Hard-coded secret detected. Use configuration/environment variables."/>
  </module>

  <module name="TreeWalker">
    <module name="SuppressWarningsHolder"/>

    <!-- Naming -->
    <module name="PackageName">
      <property name="format" value="^dev\.investai(\.[a-z][a-z0-9]*)*$"/>
    </module>
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="ConstantName"/>
    <module name="LocalVariableName"/>
    <module name="MemberName"/>
    <module name="ParameterName"/>
    <module name="LambdaParameterName"/>
    <module name="RecordComponentName"/>
    <module name="ClassTypeParameterName"/>
    <module name="MethodTypeParameterName"/>
    <module name="AbbreviationAsWordInName">
      <property name="allowedAbbreviationLength" value="1"/>
      <property name="ignoreFinal" value="false"/>
    </module>

    <!-- Imports -->
    <module name="AvoidStarImport"/>
    <module name="IllegalImport">
      <property name="illegalPkgs" value="sun, com.sun, jdk.internal, junit.framework, java.util.logging, org.apache.log4j, lombok"/>
      <property name="illegalClasses" value="org.junit.Assert"/>
    </module>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>

    <!-- Design -->
    <module name="FinalClass"/>
    <module name="HideUtilityClassConstructor">
      <property name="ignoreAnnotatedBy" value="SpringBootApplication, AnalyzeClasses"/>
    </module>
    <module name="OneTopLevelClass"/>
    <module name="InterfaceIsType"/>
    <module name="VisibilityModifier">
      <property name="protectedAllowed" value="false"/>
    </module>
    <module name="MutableException"/>
    <module name="ThrowsCount">
      <property name="max" value="3"/>
    </module>

    <!-- Coding -->
    <module name="EqualsHashCode"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="StringLiteralEquality"/>
    <module name="MissingSwitchDefault"/>
    <module name="FallThrough"/>
    <module name="EmptyStatement"/>
    <module name="EmptyBlock">
      <property name="option" value="TEXT"/>
    </module>
    <module name="EmptyCatchBlock"/>
    <module name="IllegalCatch">
      <property name="illegalClassNames" value="Error, Throwable, java.lang.Error, java.lang.Throwable"/>
    </module>
    <module name="IllegalThrows"/>
    <module name="IllegalType"/>
    <module name="InnerAssignment"/>
    <module name="ModifiedControlVariable"/>
    <module name="MultipleVariableDeclarations"/>
    <module name="OneStatementPerLine"/>
    <module name="NestedIfDepth">
      <property name="max" value="2"/>
    </module>
    <module name="NestedTryDepth"/>
    <module name="ReturnCount">
      <property name="max" value="3"/>
      <property name="maxForVoid" value="2"/>
    </module>
    <module name="ParameterAssignment"/>
    <module name="DeclarationOrder"/>
    <module name="MagicNumber">
      <property name="ignoreHashCodeMethod" value="true"/>
      <property name="ignoreAnnotation" value="true"/>
      <property name="ignoreFieldDeclaration" value="true"/>
    </module>
    <module name="UpperEll"/>
    <module name="ArrayTypeStyle"/>
    <module name="NeedBraces"/>
    <module name="AvoidNestedBlocks"/>
    <module name="UnnecessaryParentheses"/>
    <module name="UnusedLocalVariable"/>
    <module name="TodoComment">
      <property name="format" value="(TODO|FIXME)(?!\(#\d+\))"/>
      <message key="todo.match" value="TODO/FIXME must reference an issue: TODO(#123)."/>
    </module>

    <!-- Size / complexity -->
    <module name="MethodLength">
      <property name="max" value="40"/>
    </module>
    <module name="ParameterNumber">
      <property name="max" value="6"/>
      <property name="ignoreAnnotatedBy" value="Override"/>
    </module>
    <module name="CyclomaticComplexity">
      <property name="max" value="10"/>
    </module>
    <module name="NPathComplexity">
      <property name="max" value="100"/>
    </module>
    <module name="BooleanExpressionComplexity"/>
    <module name="ClassFanOutComplexity">
      <property name="max" value="20"/>
    </module>

    <!-- Javadoc on public types of main code (tests suppressed) -->
    <module name="MissingJavadocType">
      <property name="scope" value="public"/>
      <property name="skipAnnotations" value="Generated, SpringBootApplication"/>
    </module>
  </module>
</module>
