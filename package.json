{
  "name": "investai",
  "private": true,
  "description": "Repository tooling (git hooks, commit conventions). App code lives in backend/ and frontend/.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "lefthook install",
    "check:backend": "node scripts/backend-verify.mjs",
    "check:frontend": "cd frontend && npm run check",
    "check:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "check": "npm run check:scripts && npm run check:backend && npm run check:frontend",
    "secrets": "gitleaks git --redact --no-banner -v .",
    "api:update": "node scripts/update-api-contract.mjs",
    "stack:start": "node scripts/local-stack.mjs start",
    "stack:status": "node scripts/local-stack.mjs status",
    "stack:stop": "node scripts/local-stack.mjs stop"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "lefthook": "^2.2.1"
  }
}
