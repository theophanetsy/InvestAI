    "/api/v1/market/indicators" : {
      "get" : {
        "operationId" : "screenInstruments",
        "parameters" : [ {
          "in" : "query",
          "name" : "peaEligibility",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ],
            "enum" : [ "ELIGIBLE", "NOT_ELIGIBLE", "UNKNOWN" ]
          }
        }, {
          "example" : 25,
          "in" : "query",
          "name" : "maxVolatility",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ],
            "example" : 25,
            "pattern" : "^\\d{1,6}(\\.\\d{1,2})?$"
          }
        }, {
          "example" : 100000,
          "in" : "query",
          "name" : "minAverageDailyTradedAmount",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ],
            "example" : 100000,
            "pattern" : "^\\d{1,13}(\\.\\d{1,2})?$"
          }
        }, {
          "in" : "query",
          "name" : "performanceWindow",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ],
            "default" : "ONE_YEAR",
            "enum" : [ "ONE_MONTH", "THREE_MONTHS", "SIX_MONTHS", "ONE_YEAR" ]
          }
        }, {
          "example" : 0,
          "in" : "query",
          "name" : "minPerformance",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ],
            "example" : 0,
            "pattern" : "^-?\\d{1,6}(\\.\\d{1,2})?$"
          }
        }, {
          "in" : "query",
          "name" : "sort",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ],
            "default" : "PERFORMANCE",
            "enum" : [ "PERFORMANCE", "VOLATILITY", "LIQUIDITY", "MAX_DRAWDOWN" ]
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "type" : [ "integer", "null" ],
            "format" : "int32",
            "default" : 50,
            "maximum" : 50,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ScreeningResponse"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Erreur (RFC 9457) : voir `code`"
          }
        },
        "tags" : [ "market" ]
      }
    },
