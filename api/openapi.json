  "components" : {
    "schemas" : {
      "CashRequest" : {
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "string",
            "example" : "350.00",
            "pattern" : "^\\d{1,13}(\\.\\d{1,2})?$"
          }
        },
        "required" : [ "amount" ]
      },
      "CashResponse" : {
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "string",
            "example" : "350.00",
            "pattern" : "^\\d+\\.\\d{2}$"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "weightPercent" : {
            "type" : "string",
            "example" : "12.50"
          }
        },
        "required" : [ "amount", "updatedAt" ]
      },
      "CurrentUserResponse" : {
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string"
          }
        },
        "required" : [ "username" ]
      },
      "DailyCloseResponse" : {
        "type" : "object",
        "properties" : {
          "close" : {
            "type" : "string",
            "example" : "173.1600",
            "pattern" : "^\\d+\\.\\d{4}$"
          },
          "currency" : {
            "type" : "string"
          },
          "date" : {
            "type" : "string",
            "format" : "date"
          },
          "source" : {
            "type" : "string",
            "enum" : [ "EURONEXT", "EODHD" ]
          },
          "tradeCount" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 4321,
            "minimum" : 0
          },
          "volume" : {
            "type" : "integer",
            "format" : "int64",
            "example" : 812345,
            "minimum" : 0
          }
        },
        "required" : [ "close", "currency", "date", "source" ]
      },
      "DeclaredLineResponse" : {
        "type" : "object",
        "properties" : {
          "averagePrice" : {
            "type" : "string",
            "example" : "150.1234",
            "pattern" : "^\\d+\\.\\d{4}$"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "instrumentId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int64"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "id", "instrumentId", "quantity", "updatedAt" ]
      },
      "FieldViolation" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "field" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "field" ]
      },
      "InstrumentDetailsResponse" : {
        "type" : "object",
        "properties" : {
          "currency" : {
            "type" : "string"
          },
          "historyLoaded" : {
            "type" : "boolean"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "isin" : {
            "type" : "string"
          },
          "lastClose" : {
            "$ref" : "#/components/schemas/DailyCloseResponse"
          },
          "mic" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "peaEligibility" : {
            "$ref" : "#/components/schemas/PeaEligibilityResponse"
          },
          "ticker" : {
            "type" : "string"
          },
          "trackedSince" : {
            "type" : "string",
            "format" : "date-time"
          },
          "type" : {
            "type" : "string",
            "enum" : [ "STOCK", "ETF", "FUND", "OTHER" ]
          }
        },
        "required" : [ "currency", "historyLoaded", "id", "isin", "mic", "name", "peaEligibility", "ticker", "type" ]
      },
      "InstrumentSummaryResponse" : {
        "type" : "object",
        "properties" : {
          "currency" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "isin" : {
            "type" : "string"
          },
          "mic" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "peaEligibility" : {
            "$ref" : "#/components/schemas/PeaEligibilityResponse"
          },
          "ticker" : {
            "type" : "string"
          },
          "tracked" : {
            "type" : "boolean"
          },
          "type" : {
            "type" : "string",
            "enum" : [ "STOCK", "ETF", "FUND", "OTHER" ]
          }
        },
        "required" : [ "currency", "id", "isin", "mic", "name", "peaEligibility", "ticker", "tracked", "type" ]
      },
      "LastCloseResponse" : {
        "type" : "object",
        "properties" : {
          "close" : {
            "type" : "string",
            "example" : "173.1600"
          },
          "date" : {
            "type" : "string",
            "format" : "date"
          }
        },
        "required" : [ "close", "date" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "password" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "username" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        },
        "required" : [ "password", "username" ]
      },
      "PeaEligibilityRequest" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "ELIGIBLE", "NOT_ELIGIBLE", "UNKNOWN" ]
          }
        },
        "required" : [ "status" ]
      },
      "PeaEligibilityResponse" : {
        "type" : "object",
        "properties" : {
          "source" : {
            "type" : "string",
            "enum" : [ "RULE", "OWNER" ]
          },
          "status" : {
            "type" : "string",
            "enum" : [ "ELIGIBLE", "NOT_ELIGIBLE", "UNKNOWN" ]
          }
        },
        "required" : [ "source", "status" ]
      },
      "PortfolioLineRequest" : {
        "type" : "object",
        "properties" : {
          "averagePrice" : {
            "type" : "string",
            "example" : "150.1234",
            "pattern" : "^\\d{1,15}(\\.\\d{1,4})?$"
          },
          "instrumentId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int64",
            "maximum" : 1000000000,
            "minimum" : 1
          }
        },
        "required" : [ "instrumentId", "quantity" ]
      },
      "PortfolioLineResponse" : {
        "type" : "object",
        "properties" : {
          "averagePrice" : {
            "type" : "string",
            "example" : "150.1234"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "instrument" : {
            "$ref" : "#/components/schemas/InstrumentSummaryResponse"
          },
          "lastClose" : {
            "$ref" : "#/components/schemas/LastCloseResponse"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int64"
          },
          "unrealizedGain" : {
            "type" : "string",
            "example" : "230.37"
          },
          "unrealizedGainPercent" : {
            "type" : "string",
            "example" : "15.35"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "value" : {
            "type" : "string",
            "example" : "1731.60"
          },
          "weightPercent" : {
            "type" : "string",
            "example" : "42.10"
          }
        },
        "required" : [ "id", "instrument", "quantity", "updatedAt" ]
      },
      "PortfolioLineUpdateRequest" : {
        "type" : "object",
        "properties" : {
          "averagePrice" : {
            "type" : "string",
            "example" : "150.1234",
            "pattern" : "^\\d{1,15}(\\.\\d{1,4})?$"
          },
          "quantity" : {
            "type" : "integer",
            "format" : "int64",
            "maximum" : 1000000000,
            "minimum" : 1
          }
        },
        "required" : [ "quantity" ]
      },
      "PortfolioResponse" : {
        "type" : "object",
