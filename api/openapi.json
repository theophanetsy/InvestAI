{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "InvestAI API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "",
    "description" : "Même origine que le frontend"
  } ],
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Erreur (RFC 9457) : voir `code`"
          }
        },
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "responses" : {
          "204" : {
            "description" : "Session fermée"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Erreur (RFC 9457) : voir `code`"
          }
        },
        "summary" : "Ferme la session (cookie supprimé)",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUserResponse"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Erreur (RFC 9457) : voir `code`"
          }
        },
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/status" : {
      "get" : {
        "operationId" : "getStatus",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StatusResponse"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Erreur (RFC 9457) : voir `code`"
          }
        },
        "tags" : [ "system" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CurrentUserResponse" : {
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string"
          }
        },
        "required" : [ "username" ]
      },
      "FieldViolation" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "field" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "field" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "password" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "username" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        },
        "required" : [ "password", "username" ]
      },
      "Problem" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "errors" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FieldViolation"
            }
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "requestId" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        },
        "required" : [ "code", "requestId", "status", "title" ]
      },
      "StatusResponse" : {
        "type" : "object",
        "properties" : {
          "application" : {
            "type" : "string"
          },
          "serverTime" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "application", "serverTime" ]
      }
    }
  }
}
