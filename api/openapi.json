  "components" : {
    "schemas" : {
      "BenchmarkComparisonResponse" : {
        "type" : "object",
        "properties" : {
          "beta" : {
            "$ref" : "#/components/schemas/IndicatorResponse"
          },
          "correlation" : {
            "$ref" : "#/components/schemas/IndicatorResponse"
          },
          "outperformance" : {
            "$ref" : "#/components/schemas/IndicatorResponse"
          }
        },
        "required" : [ "beta", "correlation", "outperformance" ]
      },
      "CashRequest" : {
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "string",
            "example" : "350.00",
            "pattern" : "^\\d{1,13}(\\.\\d{1,2})?$"
          }
        },
        "required" : [ "amount" ]
      },
      "CashResponse" : {
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "string",
            "example" : "350.00",
            "pattern" : "^\\d+\\.\\d{2}$"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "weightPercent" : {
            "type" : "string",
            "example" : "12.50"
          }
        },
        "required" : [ "amount", "updatedAt" ]
      },
      "CompositionResponse" : {
        "type" : "object",
        "properties" : {
          "cashPercent" : {
            "$ref" : "#/components/schemas/IndicatorResponse"
          },
          "etfPercent" : {
            "$ref" : "#/components/schemas/IndicatorResponse"
          },
          "herfindahlIndex" : {
            "$ref" : "#/components/schemas/IndicatorResponse"
          },
          "largestLinePercent" : {
            "$ref" : "#/components/schemas/IndicatorResponse"
          },
          "lineCount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "otherPercent" : {
            "$ref" : "#/components/schemas/IndicatorResponse"
          },
          "stockPercent" : {
            "$ref" : "#/components/schemas/IndicatorResponse"
          }
        },
        "required" : [ "cashPercent", "etfPercent", "herfindahlIndex", "largestLinePercent", "lineCount", "otherPercent", "stockPercent" ]
      },
      "CorrelationMatrixResponse" : {
        "type" : "object",
        "properties" : {
          "instrumentIds" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            }
          },
          "rows" : {
            "type" : "array",
            "items" : {
              "type" : "array",
              "items" : {
                "$ref" : "#/components/schemas/IndicatorResponse"
              }
            }
          }
        },
        "required" : [ "instrumentIds", "rows" ]
      },
      "CurrentUserResponse" : {
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string"
          }
        },
        "required" : [ "username" ]
      },
      "CurvePointResponse" : {
        "type" : "object",
        "properties" : {
          "cac40" : {
            "type" : "string",
            "example" : "98.75"
          },
          "date" : {
            "type" : "string",
            "format" : "date"
          },
          "msciWorld" : {
            "type" : "string",
            "example" : "102.10"
          },
          "portfolio" : {
            "type" : "string",
            "example" : "104.35"
          }
        },
        "required" : [ "date" ]
      },
      "DailyCloseResponse" : {
        "type" : "object",
        "properties" : {
          "close" : {
            "type" : "string",
            "example" : "173.1600",
            "pattern" : "^\\d+\\.\\d{4}$"
          },
          "currency" : {
            "type" : "string"
          },
          "date" : {
            "type" : "string",
            "format" : "date"
          },
          "source" : {
            "type" : "string",
            "enum" : [ "EURONEXT", "EODHD" ]
          },
          "tradeCount" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 4321,
            "minimum" : 0
          },
          "volume" : {
            "type" : "integer",
            "format" : "int64",
            "example" : 812345,
            "minimum" : 0
